{
  "manifest_version": 2,
  "name": "__MSG_extensionName__",
  "description": "__MSG_extensionDescription__",
  "version": "0.9.2",
  "author": "Stefan Scherer – ts-scherer.com",
  "homepage_url": "https://github.com/Stefan2706/teamsignatur",
  "default_locale": "de",
  "browser_specific_settings": {
    "gecko": {
      "id": "teamsignatur@ts-scherer.com",
      "strict_min_version": "128.0",
      "update_url": "https://raw.githubusercontent.com/Stefan2706/teamsignatur/main/updates.json"
    }
  },
  "icons": {
    "32": "icons/icon.svg",
    "64": "icons/icon.svg"
  },
  "permissions": [
    "storage",
    "accountsRead",
    "accountsIdentities",
    "addressBooks",
    "menus"
  ],
  "optional_permissions": [
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "lib/render.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "__MSG_actionTitle__",
    "default_label": "__MSG_actionLabel__",
    "default_icon": "icons/icon.svg"
  },
  "options_ui": {
    "page": "page/signatur.html",
    "open_in_tab": true
  }
}